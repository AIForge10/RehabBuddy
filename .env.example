# ============================================================
# RehabBuddy backend config
# 1. Copy this file:   cp .env.example .env
# 2. Fill in the real values in .env (NOT in this file)
# 3. Never commit .env; share keys only by private DM
# ============================================================

# ---------- Gemini (pain check-in, summary, translation) ----------
# Get it at: https://aistudio.google.com/apikey  (already created and tested)
GEMINI_API_KEY=
# Check the current Flash model name in Google AI Studio
GEMINI_MODEL=gemini-3.6-flash
# Thinking for the spoken pain-check reply: "minimal" is fastest. Models that
# don't support it (gemini-2.5-flash, gemini-3.7-flash, gemini-3.8-flash) need "low".
GEMINI_THINKING_LEVEL=minimal

# ---------- Tiger Data (PostgreSQL + TimescaleDB) ----------
# Tiger console > service "rehabbuddy-dev" > Connect > copy the connection string
# Format: postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require
DATABASE_URL=

# ---------- ElevenLabs (voice coach; Shan's account, 131k credits) ----------
# elevenlabs.io > Profile > API Keys
ELEVENLABS_API_KEY=
# Voice IDs aren't secret, so they live here for everyone to share.
# "Talia - Warm Soft Guide" (Voice Library). One voice for both languages so
# the coach sounds like the same person; the multilingual models speak Spanish.
# To change: elevenlabs.io > Voices > pick a voice > copy its Voice ID
ELEVENLABS_VOICE_ID_EN=OZ0L6eISlOejga3XjDFt
ELEVENLABS_VOICE_ID_ES=OZ0L6eISlOejga3XjDFt
# Live pain-check replies. Fixed cue clips are made ahead of time with
# scripts/generate_audio.py (eleven_multilingual_v2).
ELEVENLABS_MODEL=eleven_flash_v2_5

# ---------- Sign-up ----------
# New patients join this therapist's caseload (the demo's Dr. Lee), so the
# dashboard shows them. Leave empty to keep new patients unassigned.
SIGNUP_THERAPIST_ID=t-lee

# ---------- CORS: which frontend URLs may call the backend ----------
# Read by backend/api/core/config.py as BACKEND_CORS_ORIGINS, a JSON list. Leave it unset for the
# defaults (localhost:5173/5174 and the phone apps). On DigitalOcean it is set in .do/app.yaml.
# BACKEND_CORS_ORIGINS=["http://localhost:5173","https://bendwith.us"]

# ---------- Clinic time zone ----------
# Dates the server writes into text (the plan suggestion's "pain 8/10 on Sep 26") use this
# calendar, not the server's UTC one. An IANA name.
# CLINIC_TIMEZONE=America/New_York

# ---------- Server ----------
# Local default. DigitalOcean sets PORT itself on deploy.
PORT=8000
