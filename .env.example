# ============================================================
# RehabBuddy backend config
# 1. Copy this file:   cp .env.example .env
# 2. Fill in the real values in .env (NOT in this file)
# 3. Never commit .env; share keys only by private DM
# ============================================================

# ---------- Gemini (pain check-in, summary, translation) ----------
# Get it at: https://aistudio.google.com/apikey  (already created and tested)
GEMINI_API_KEY=
# Check the current Flash model name in Google AI Studio
GEMINI_MODEL=gemini-2.5-flash

# ---------- Tiger Data (PostgreSQL + TimescaleDB) ----------
# Tiger console > service "rehabbuddy-dev" > Connect > copy the connection string
# Format: postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require
DATABASE_URL=

# ---------- ElevenLabs (voice coach; Shan's account, 131k credits) ----------
# elevenlabs.io > Profile > API Keys
ELEVENLABS_API_KEY=
# Voice IDs aren't secret, so they live here for everyone to share.
# "Talia - Warm Soft Guide" (Voice Library). One voice for both languages so
# the coach sounds like the same person; the multilingual models speak Spanish.
# To change: elevenlabs.io > Voices > pick a voice > copy its Voice ID
ELEVENLABS_VOICE_ID_EN=OZ0L6eISlOejga3XjDFt
ELEVENLABS_VOICE_ID_ES=OZ0L6eISlOejga3XjDFt

# ---------- CORS: which frontend URLs may call the backend ----------
# Local dev is 5173 (Vite). After deploy, add the GoDaddy domain, comma-separated:
# CORS_ORIGINS=http://localhost:5173,https://rehabbuddy.xyz
CORS_ORIGINS=http://localhost:5173

# ---------- Server ----------
# Local default. DigitalOcean sets PORT itself on deploy.
PORT=8000
