# Copy: cp mobile/.env.example mobile/.env
# Settings for the iOS/Android app build. Same variables as frontend/.env, kept
# apart so the app can point at a different backend than local web dev.
# Everything here ends up inside the app: never put secret keys here.

# true = the app runs on its built-in mock backend (no server, demo data).
# false = real backend at VITE_API_URL; log in as a seeded demo account (docs/AUTH.md).
VITE_USE_MOCKS=true

# The backend, including /api/v1. Only the iOS Simulator can reach your Mac's localhost:
#   iOS Simulator:                     http://localhost:8000/api/v1
#   Android emulator and real phones:  the deployed HTTPS backend
VITE_API_URL=http://localhost:8000/api/v1

VITE_DEMO_PATIENT_ID=p-maria
VITE_DEMO_THERAPIST_ID=t-lee
