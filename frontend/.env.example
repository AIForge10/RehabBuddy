# Copy: cp frontend/.env.example frontend/.env
# Where the frontend sends API calls.
# Local:  http://localhost:8000
# Deploy: the DigitalOcean backend URL (Luis sends it after deploying)
# Vite only exposes variables that start with VITE_.
# Never put secret keys here: anything in this file is visible in the browser.
VITE_API_URL=http://localhost:8000

# true = run the whole UI against the in-browser mock backend (no FastAPI needed).
VITE_USE_MOCKS=true
# true = with mocks on, still send the pain check to the backend at VITE_API_URL
# (Gemini writes the coach's reply, ElevenLabs voices it). Needs the backend running.
VITE_LIVE_AI=false
# Which patient / therapist the demo logs in as (must match database/seed.py ids).
VITE_DEMO_PATIENT_ID=p-maria
VITE_DEMO_THERAPIST_ID=t-lee
