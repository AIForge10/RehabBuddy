# Copy: cp frontend/.env.example frontend/.env
# Where the frontend sends API calls, including the backend's /api/v1 prefix.
# Local:  http://localhost:8000/api/v1
# Deploy: the DigitalOcean backend URL + /api/v1 (Luis sends it after deploying)
# Vite only exposes variables that start with VITE_.
# Never put secret keys here: anything in this file is visible in the browser.
VITE_API_URL=http://localhost:8000/api/v1

# true = run the whole UI against the in-browser mock backend (no FastAPI, no login).
# false = real backend; log in as a seeded demo account (docs/AUTH.md).
VITE_USE_MOCKS=true

# "Sign in with Google" button: the same OAuth web client id as GOOGLE_CLIENT_ID in the
# root .env (not a secret). Unset, or in mock mode: the button is hidden.
# VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Which patient / therapist the demo logs in as (ids from database/sample_data/tables/profiles.csv).
VITE_DEMO_PATIENT_ID=p-maria
VITE_DEMO_THERAPIST_ID=t-lee
